{
  "name": "propinc",
  "private": true,
  "type": "module",
  "description": "PropInc — simulatore di propagazione degli incendi boschivi (tesi triennale)",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "node --test \"tests/engine/*.test.js\" \"tests/pipeline/*.test.js\" \"tests/validation/*.test.js\"",
    "test:server": "npm test --prefix backend",
    "test:all": "npm test && npm run test:server",
    "sim": "node engine/cli.js",
    "experiments": "node experiments/run.js",
    "bench": "node experiments/bench.js",
    "validate": "node validation/validate.js"
  }
}
